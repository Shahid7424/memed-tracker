# Sample environment for the whole project. Each app reads its own file:
#   backend/.env       (copy from backend/.env.example)
#   frontend/.env.local (copy from frontend/.env.example)

# ---- backend ----
PORT=4000
# Must be a replica set (Atlas clusters, including free M0, are). Payout updates use transactions.
MONGODB_URI=mongodb://localhost:27017/memed?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins allowed by CORS (e.g. your Vercel URL)
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ---- frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
