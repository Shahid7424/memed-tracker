# Port the API listens on
PORT=4000
# MongoDB connection string. Must point at a replica set (MongoDB Atlas clusters,
# including the free M0 tier, are replica sets). Payout updates use transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/memed?replicaSet=rs0
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid (jsonwebtoken format, e.g. 7d, 12h)
JWT_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:3000
# development | production | test
NODE_ENV=development
